# Node / Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=smartcare_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
DATABASE_URL="postgresql://smartcare:smartcare_password_2026@localhost:5432/smartcare_db?schema=public"
# SQLite Alternative for local development without Docker/Postgres:
# DATABASE_URL="file:./dev.db"

# Flask AI Server Integration
AI_SERVER_URL="http://localhost:5001"

# Cors Config
CORS_ORIGIN="http://localhost:5173"

# Software Alert Thresholds (Configurable)
MIN_HEART_RATE=50
MAX_HEART_RATE=120
MIN_SPO2_WARNING=94
MIN_SPO2_CRITICAL=90
MIN_TEMP=36.0
MAX_TEMP=38.0

# Device Auth Master Key (for IoT setup)
DEVICE_MASTER_KEY=device_secret_smartcare_2026
